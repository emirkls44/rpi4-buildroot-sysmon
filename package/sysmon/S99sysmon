#!/bin/sh

case "$1" in
	start)
		printf "Starting sysmon: "
		start-stop-daemon -S -b -q -m -p /var/run/sysmon.pid -x /bin/sh -- -c "exec /usr/bin/sysmon > /dev/console 2>&1"
		echo "OK"
		;;
	stop)
		printf "Stopping sysmon: "
		start-stop-daemon -K -q -p /var/run/sysmon.pid
		echo "OK"
		;;
	restart)
		"$0" stop
		"$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
esac
